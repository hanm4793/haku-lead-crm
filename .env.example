# 1. URL chính thức của ứng dụng (Dùng để tạo link trong email đặt lại mật khẩu)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 2. Cơ sở dữ liệu & Supabase Auth
# Dùng chuỗi Transaction Pooler (cổng 6543) cho DATABASE_URL trên Vercel
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: Dùng để gửi email mời / đặt lại mật khẩu khi tạo tài khoản. Tuyệt đối không đưa ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Danh sách email tự động nâng quyền SUPER_ADMIN khi đăng nhập lần đầu (phân tách bằng dấu phẩy)
ADMIN_EMAILS=

# 3. Meta Lead Ads / Graph API (Server-only)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_IDS=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_GRAPH_VERSION=v21.0

# 4. Bảo mật Cron Job tự động đồng bộ (/api/cron/facebook-sync)
CRON_SECRET=

# 5. Trợ lý AI (Server-only: google | groq | openrouter | deepseek | ollama)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
